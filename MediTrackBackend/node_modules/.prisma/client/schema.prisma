generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("doctor") // doctor | staff | admin
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  title        String?
  department   String?
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Patient {
  id             String    @id @default(cuid())
  encryptedName  String    @map("encrypted_name")
  encryptedPhone String    @map("encrypted_phone")
  encryptedEmail String?   @map("encrypted_email")
  encryptedNotes String?   @map("encrypted_notes")
  birthDate      DateTime? @map("birth_date")
  gender         String?
  doctorId       String    @map("doctor_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  appointments Appointment[]

  @@map("patients")
}

model Appointment {
  id             String   @id @default(cuid())
  doctorId       String   @map("doctor_id")
  patientId      String?  @map("patient_id")
  encryptedName  String   @map("encrypted_name")
  encryptedPhone String   @map("encrypted_phone")
  date           String
  time           String
  encryptedNotes String?  @map("encrypted_notes")
  status         String   @default("upcoming")
  type           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  doctor  User     @relation(fields: [doctorId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@unique([doctorId, date, time])
  @@map("appointments")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  resource  String?
  metadata  String?  @db.Text
  ipAddress String?  @map("ip_address")
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
